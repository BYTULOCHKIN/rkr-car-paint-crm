[Unit]
Description=Deploy prebuilt GitHub main ARM64 releases for PaintAuto
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/paintauto/autodeploy.py
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
