[Unit]
Description=Back up PaintAuto SQLite databases to private S3
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/rkr-crm
EnvironmentFile=/etc/paintauto-backup.env
ExecStart=/bin/bash /opt/rkr-crm/deploy/backup-to-s3.sh
Nice=10
