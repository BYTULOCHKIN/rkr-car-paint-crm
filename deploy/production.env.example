# Copy to .env.production in the repository root; do not commit the filled file.
# Hostname only: no scheme, port, or path.
CRM_DOMAIN=paintauto.pp.ua
ACME_EMAIL=admin@example.com

# Use keys from the SAME Clerk production instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_SECRET_KEY=sk_live_REPLACE_ME

# Only needed when claiming an existing legacy database (see docs/crm.md).
CRM_ADMIN_USER_ID=

# Set automatically by the deployment controller. Leave empty for a manual build.
CRM_IMAGE=rkr-crm:local
